@startuml
title Use Case Diagram - Class Schedule System

left to right direction
skinparam packageStyle rectangle

actor Student
actor Teacher
actor "Department Staff" as Staff
actor Administrator as Admin

rectangle "Class Schedule System" {

  usecase "View Group Schedule" as UC1
  usecase "View Teacher Schedule" as UC2
  usecase "View Lesson Details" as UC3

  usecase "Create Schedule" as UC4
  usecase "Edit Schedule" as UC5
  usecase "Delete Schedule" as UC6
  usecase "Validate Schedule" as UC7

  usecase "Manage Users" as UC8
  usecase "Manage System Settings" as UC9
  usecase "Check Schedule Conflicts" as UC10
}

Student --> UC1
Student --> UC3

Teacher --> UC2
Teacher --> UC3

Staff --> UC1
Staff --> UC2
Staff --> UC4
Staff --> UC5
Staff --> UC6
Staff --> UC7

Admin --> UC8
Admin --> UC9
Admin --> UC1

UC4 .> UC10 : <<include>>
UC5 .> UC10 : <<include>>
UC7 .> UC10 : <<include>>

@enduml
