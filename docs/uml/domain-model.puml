
@startuml
title Domain Model - Class Schedule System

skinparam classAttributeIconSize 0
skinparam shadowing false

class Student {
  +studentId: int
  +fullName: string
  +email: string
}

class Teacher {
  +teacherId: int
  +fullName: string
  +email: string
}

class DepartmentStaff {
  +staffId: int
  +fullName: string
  +email: string
}

class Administrator {
  +adminId: int
  +fullName: string
  +email: string
}

class StudyGroup {
  +groupId: int
  +name: string
  +specialty: string
}

class Subject {
  +subjectId: int
  +name: string
  +description: string
}

class Classroom {
  +classroomId: int
  +number: string
  +capacity: int
}

class Schedule {
  +scheduleId: int
  +semester: string
  +academicYear: string
}

class Lesson {
  +lessonId: int
  +date: Date
  +startTime: Time
  +endTime: Time
  +lessonType: string
}

StudyGroup "1" -- "0..*" Student : includes

Schedule "1" *-- "1..*" Lesson : contains

StudyGroup "1" -- "0..*" Lesson : has
Teacher "1" -- "0..*" Lesson : conducts
Subject "1" -- "0..*" Lesson : describes
Classroom "1" -- "0..*" Lesson : hosts

DepartmentStaff ..> Schedule : manages
Administrator ..> Student : manages
Administrator ..> Teacher : manages

@enduml
